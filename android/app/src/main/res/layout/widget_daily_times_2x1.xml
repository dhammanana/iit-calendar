<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="5dp">

    <!-- Dawn Column Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:layout_marginEnd="3dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/widget_circle_dawn"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sun_dawn"
                    android:contentDescription="Dawn"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dawn"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="true"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvDawnTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="17sp"
                android:singleLine="true"
                android:maxLines="1"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tvDawnAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textStyle="bold"
                android:textSize="10sp"
                android:singleLine="true"
                android:maxLines="1"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Noon Column Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:layout_marginStart="3dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/widget_circle_noon"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sun_noon"
                    android:contentDescription="Noon"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Noon"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="true"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvNoonTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="17sp"
                android:singleLine="true"
                android:maxLines="1"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tvNoonAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textStyle="bold"
                android:textSize="10sp"
                android:singleLine="true"
                android:maxLines="1"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
